{
  "uid": "shop-latency",
  "title": "Shop API - Latency",
  "tags": ["hw3", "shop"],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "10s",
  "time": {"from": "now-15m", "to": "now"},
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Mean request duration by route",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 0},
      "fieldConfig": {
        "defaults": {"unit": "s", "min": 0},
        "overrides": []
      },
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (handler, method) (rate(http_request_duration_seconds_sum{job=\"shop-api\"}[1m])) / sum by (handler, method) (rate(http_request_duration_seconds_count{job=\"shop-api\"}[1m]))",
          "legendFormat": "{{method}} {{handler}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Overall request duration percentiles",
      "description": "Estimated across all routes using the default high-resolution histogram. Its smallest bucket is 10 ms; sub-10 ms percentiles are interpolated, not precise timings.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 10},
      "fieldConfig": {
        "defaults": {"unit": "s", "min": 0},
        "overrides": []
      },
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}},
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_highr_seconds_bucket{job=\"shop-api\"}[1m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_highr_seconds_bucket{job=\"shop-api\"}[1m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_highr_seconds_bucket{job=\"shop-api\"}[1m])))",
          "legendFormat": "p99"
        }
      ]
    }
  ]
}
