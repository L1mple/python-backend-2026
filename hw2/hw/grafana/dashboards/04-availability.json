      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(http_request_duration_highr_seconds_bucket{job=~\"$job\", le=\"0.25\"}[5m])) / sum(rate(http_request_duration_highr_seconds_count{job=~\"$job\"}[5m]))",
