          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "(sum(rate(http_requests_total{status=\"5xx\"}[5m])) or vector(0)) / clamp_min((sum(rate(http_requests_total[5m])) or vector(0)), 1e-9)",
          "legendFormat": "5xx ratio",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "5xx error ratio",
      "type": "stat"
    }
