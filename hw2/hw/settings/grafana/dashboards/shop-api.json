{
  "uid": "shop-api",
  "title": "Shop API",
  "tags": ["shop-api", "fastapi"],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {"from": "now-15m", "to": "now"},
  "templating": {"list": []},
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "RPS (всего)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "targets": [
        {"refId": "A", "expr": "sum(rate(http_requests_total{job=\"shop-api\"}[1m]))"}
      ],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "area"},
      "fieldConfig": {"defaults": {"unit": "reqps", "decimals": 1, "color": {"mode": "fixed", "fixedColor": "green"}}, "overrides": []}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Доля ошибок 5xx",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "targets": [
        {"refId": "A", "expr": "100 * sum(rate(http_requests_total{job=\"shop-api\", status=~\"5..\"}[1m])) / clamp_min(sum(rate(http_requests_total{job=\"shop-api\"}[1m])), 1e-9)"}
      ],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "none"},
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "decimals": 2, "min": 0,
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}, {"color": "red", "value": 5}]}
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "RPS по ручкам",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"refId": "A", "expr": "sum by (method, handler) (rate(http_requests_total{job=\"shop-api\"}[1m]))", "legendFormat": "{{method}} {{handler}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "reqps", "custom": {"lineWidth": 1, "fillOpacity": 10, "showPoints": "never"}}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "right", "calcs": ["mean", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Размер ответа (среднее, байт)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 20, "w": 12, "h": 7},
      "targets": [
        {"refId": "A", "expr": "sum by (handler) (rate(http_response_size_bytes_sum{job=\"shop-api\"}[1m])) / clamp_min(sum by (handler) (rate(http_response_size_bytes_count{job=\"shop-api\"}[1m])), 1e-9)", "legendFormat": "{{handler}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "bytes", "custom": {"lineWidth": 1, "fillOpacity": 0, "showPoints": "never"}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}}
    }
  ]
}
