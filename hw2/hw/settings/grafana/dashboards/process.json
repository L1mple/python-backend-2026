{
  "uid": "shop-process",
  "title": "Shop API - процесс",
  "time": { "from": "now-15m", "to": "now" },
  "refresh": "10s",
  "schemaVersion": 39,
  "panels": [
    {
      "type": "timeseries",
      "title": "Память (RSS)",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "targets": [
        { "expr": "process_resident_memory_bytes{job=\"shop-api\"}", "legendFormat": "rss" }
      ]
    },
    {
      "type": "timeseries",
      "title": "CPU",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit" } },
      "targets": [
        { "expr": "rate(process_cpu_seconds_total{job=\"shop-api\"}[1m])", "legendFormat": "cpu" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Открытые файлы",
      "gridPos": { "x": 0, "y": 9, "w": 12, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "process_open_fds{job=\"shop-api\"}", "legendFormat": "fds" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Сборки мусора (GC)",
      "gridPos": { "x": 12, "y": 9, "w": 12, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "rate(python_gc_collections_total{job=\"shop-api\"}[1m])", "legendFormat": "gen {{generation}}" }
      ]
    }
  ]
}
