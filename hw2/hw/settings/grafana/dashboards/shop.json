{
  "uid": "shop-api",
  "title": "Shop API",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "refresh": "10s",
  "schemaVersion": 39,
  "panels": [
    {
      "type": "timeseries",
      "title": "RPS по ручкам",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (method, handler) (rate(http_requests_total[1m]))",
          "legendFormat": "{{method}} {{handler}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Ответы по статусам",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (status) (rate(http_requests_total[1m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Latency",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(http_request_duration_highr_seconds_bucket[1m])))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_highr_seconds_bucket[1m])))",
          "legendFormat": "p95"
        }
      ]
    }
  ]
}
