{
  "uid": "shop-api",
  "title": "Shop API",
  "schemaVersion": 40,
  "version": 2,
  "refresh": "5s",
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datacenter",
        "label": "Datacenter",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(up{job=\"shop\"},datacenter)",
        "definition": "label_values(up{job=\"shop\"},datacenter)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      },
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(up{job=\"shop\",datacenter=~\"$datacenter\"},instance)",
        "definition": "label_values(up{job=\"shop\",datacenter=~\"$datacenter\"},instance)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Availability",
      "description": "",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg(up{job=\"shop\",datacenter=~\"$datacenter\",instance=~\"$instance\"})",
          "legendFormat": "Scrape success"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 2,
      "title": "Created resources",
      "description": "Successful creations since process start; not current inventory size.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (resource) (shop_created_total{job=\"shop\",datacenter=~\"$datacenter\",instance=~\"$instance\"})",
          "legendFormat": "{{resource}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 3,
      "title": "Deletion operations",
      "description": "Successful deletion requests including repeated deletion of the same item.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(shop_item_deletions_total{job=\"shop\",datacenter=~\"$datacenter\",instance=~\"$instance\"})",
          "legendFormat": "Successful deletions"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 4,
      "title": "Requests per second",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total{job=\"shop\",datacenter=~\"$datacenter\",instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "Requests/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 5,
      "title": "Response statuses",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(http_requests_total{job=\"shop\",datacenter=~\"$datacenter\",instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 6,
      "title": "Response latency: median and p90 through p99",
      "description": "Bucket estimates across selected instances; sub-millisecond buckets resolve local API latency.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(http_request_duration_highr_seconds_bucket{job=\"shop\",datacenter=~\"$datacenter\",instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "p50 (median)"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.9, sum by (le) (rate(http_request_duration_highr_seconds_bucket{job=\"shop\",datacenter=~\"$datacenter\",instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "p90"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.91, sum by (le) (rate(http_request_duration_highr_seconds_bucket{job=\"shop\",datacenter=~\"$datacenter\",instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "p91"
        },
        {
          "refId": "D",
          "expr": "histogram_quantile(0.92, sum by (le) (rate(http_request_duration_highr_seconds_bucket{job=\"shop\",datacenter=~\"$datacenter\",instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "p92"
        },
        {
          "refId": "E",
          "expr": "histogram_quantile(0.93, sum by (le) (rate(http_request_duration_highr_seconds_bucket{job=\"shop\",datacenter=~\"$datacenter\",instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "p93"
        },
        {
          "refId": "F",
          "expr": "histogram_quantile(0.94, sum by (le) (rate(http_request_duration_highr_seconds_bucket{job=\"shop\",datacenter=~\"$datacenter\",instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "p94"
        },
        {
          "refId": "G",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_highr_seconds_bucket{job=\"shop\",datacenter=~\"$datacenter\",instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "p95"
        },
        {
          "refId": "H",
          "expr": "histogram_quantile(0.96, sum by (le) (rate(http_request_duration_highr_seconds_bucket{job=\"shop\",datacenter=~\"$datacenter\",instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "p96"
        },
        {
          "refId": "I",
          "expr": "histogram_quantile(0.97, sum by (le) (rate(http_request_duration_highr_seconds_bucket{job=\"shop\",datacenter=~\"$datacenter\",instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "p97"
        },
        {
          "refId": "J",
          "expr": "histogram_quantile(0.98, sum by (le) (rate(http_request_duration_highr_seconds_bucket{job=\"shop\",datacenter=~\"$datacenter\",instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "p98"
        },
        {
          "refId": "K",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_highr_seconds_bucket{job=\"shop\",datacenter=~\"$datacenter\",instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 7,
      "title": "Cart additions by outcome",
      "description": "Validated additions reaching the handler. Invalid HTTP input is shown in response statuses.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (rate(shop_cart_additions_total{job=\"shop\",datacenter=~\"$datacenter\",instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 8,
      "title": "Critical operation latency p95",
      "description": "Measured operations including failures: cart retrieval/calculation, mutations, catalog/cart filtering and writes. Stages without observations in this window are omitted.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, stage) (rate(shop_stage_duration_seconds_bucket{job=\"shop\",datacenter=~\"$datacenter\",instance=~\"$instance\"}[$__rate_interval]))) and on (stage) (sum by (stage) (rate(shop_stage_duration_seconds_count{job=\"shop\",datacenter=~\"$datacenter\",instance=~\"$instance\"}[$__rate_interval])) > 0)",
          "legendFormat": "{{stage}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 9,
      "title": "Observed cart value",
      "description": "Values observed on successful cart reads/additions. Request-weighted; not revenue or a census of stored carts.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(shop_cart_value_bucket{job=\"shop\",datacenter=~\"$datacenter\",instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(shop_cart_value_bucket{job=\"shop\",datacenter=~\"$datacenter\",instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 10,
      "title": "Observed cart quantity",
      "description": "Quantity in successful cart reads/additions, including unavailable items.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 27,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(shop_cart_quantity_bucket{job=\"shop\",datacenter=~\"$datacenter\",instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(shop_cart_quantity_bucket{job=\"shop\",datacenter=~\"$datacenter\",instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 11,
      "title": "Observed unavailable quantity",
      "description": "Request-weighted mean unavailable quantity in observed carts; not global deleted inventory.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(shop_cart_unavailable_quantity_sum{job=\"shop\",datacenter=~\"$datacenter\",instance=~\"$instance\"}[$__rate_interval])) / sum(rate(shop_cart_unavailable_quantity_count{job=\"shop\",datacenter=~\"$datacenter\",instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "Mean unavailable quantity/read"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 12,
      "title": "Critical operations by outcome",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 34,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (stage, result) (rate(shop_stage_duration_seconds_count{job=\"shop\",datacenter=~\"$datacenter\",instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{stage}} / {{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    }
  ]
}
